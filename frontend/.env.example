# Copia este archivo a `.env` antes de arrancar el frontend.
#
# IMPORTANTE: en Vite, solo las variables con prefijo VITE_ llegan al código
# del navegador, y quedan EMBEBIDAS en el bundle publicado. Nunca pongas aquí
# claves de API ni secretos: todo lo confidencial vive en el backend.

VITE_API_BASE_URL=http://localhost:8000
