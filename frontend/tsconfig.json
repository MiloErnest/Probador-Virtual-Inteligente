{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    // "node" hace falta para vite.config.ts (node:url). Al declarar `types`
    // explícitamente se controla qué paquetes de tipos globales entran.
    "types": ["node"],

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // Un único proyecto que cubre la aplicación y la configuración de Vite.
  // Se descartaron las "project references": exigen `composite: true`, que a
  // su vez es incompatible con `noEmit`, y no aportan nada a un proyecto de
  // este tamaño (su ventaja son las compilaciones incrementales en monorepos).
  "include": ["src", "vite.config.ts"]
}
