# Copia este archivo a `.env` y ajusta los valores.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Bash:                cp .env.example .env
#
# `.env` está en .gitignore y NUNCA debe subirse al repositorio.

# --- Aplicación ---
PROJECT_NAME=Probador Virtual
ENVIRONMENT=local
DEBUG=true

# --- Seguridad ---
# Genera uno propio con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=clave-insegura-solo-para-desarrollo

# Duración del token de acceso (minutos). 720 = 12 horas.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Base de datos ---
# Formato: postgresql+psycopg://USUARIO:CONTRASENA@HOST:PUERTO/BASE
# Debe ser "+psycopg" (psycopg 3), no "+psycopg2".
DATABASE_URL=postgresql+psycopg://vfit:vfit_dev_password@localhost:5432/vfit

# --- CORS ---
# Orígenes del frontend autorizados, separados por comas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Almacenamiento de imágenes ---
# Disco local. La costura `Storage` permite cambiar a S3/R2 sin tocar el resto
# del código (ver app/services/storage.py).
PUBLIC_BASE_URL=http://localhost:8000
MAX_UPLOAD_MB=8
