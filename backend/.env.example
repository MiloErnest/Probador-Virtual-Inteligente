# Copia este archivo a `.env` y ajusta los valores.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Bash:                cp .env.example .env
#
# `.env` está en .gitignore y NUNCA debe subirse al repositorio.

# --- Aplicación ---
PROJECT_NAME="Probador Virtual Inteligente"
ENVIRONMENT=local
DEBUG=true

# --- Seguridad ---
# Firma los tokens JWT. Genera una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Cambiarla invalida todas las sesiones abiertas.
# Con ENVIRONMENT=production, la aplicacion se NIEGA a arrancar si sigue
# siendo este valor de ejemplo o si tiene menos de 32 caracteres.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Duracion del token de acceso, en minutos. 720 = 12 horas.
# No hay refresh token ni lista de revocacion: un valor alto alarga la
# ventana en la que un token robado sigue sirviendo.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Base de datos ---
# Formato: postgresql+psycopg://USUARIO:CONTRASENA@HOST:PUERTO/BASE
# Debe ser "+psycopg" (psycopg 3), no "+psycopg2".
#
# Opción A - Docker Compose (valores por defecto de docker-compose.yml):
DATABASE_URL=postgresql+psycopg://vfit:vfit_dev_password@localhost:5432/vfit
#
# Opción B - PostgreSQL instalado nativamente:
# DATABASE_URL=postgresql+psycopg://postgres:TU_PASSWORD@localhost:5432/vfit

# --- CORS ---
# Orígenes del frontend autorizados, separados por comas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Almacenamiento de imágenes ---
# Etapa 1: disco local. La costura `Storage` permite cambiar a S3/R2 sin tocar
# el resto del código (ver app/services/storage.py).
PUBLIC_BASE_URL=http://localhost:8000
MAX_UPLOAD_MB=8

# --- Proveedor de prueba virtual (Fase 1) ---
# "local": compone la prenda sobre la foto con Pillow. NO es inteligencia
# artificial; existe para que la aplicacion funcione sin cuenta de pago.
# Un valor desconocido hace fallar el arranque del procesamiento a proposito:
# creer que usas el modelo de IA cuando no lo estas usando seria peor.
AI_PROVIDER=local

# --- Generador de disenos (Fase 2) ---
# "mock": dibuja siluetas con Pillow segun palabras clave. NO es IA.
DESIGN_PROVIDER=mock

# --- Analisis corporal (Fase 3) ---
# "mock": deriva medidas de proporciones medias sobre la altura. NO es
# vision por computador. MediaPipe entrara aqui cuando exista.
BODY_ANALYSIS_PROVIDER=mock

# --- Gemini / "Nano Banana" (solo con AI_PROVIDER=gemini) ---
# CUIDADO: cada prueba virtual genera una imagen y SE COBRA. El nivel gratuito
# de la API de Gemini NO incluye generacion de imagenes: hay que activar
# facturacion. Orden de magnitud: unas centesimas de dolar por imagen.
#
# La clave se obtiene en https://aistudio.google.com/apikey
# NUNCA la escribas en el codigo ni la subas al repositorio: este archivo .env
# esta en .gitignore precisamente por esto.
GEMINI_API_KEY=

# Modelo de imagen. Los "flash" son mas baratos y rapidos; el "pro" da mejor
# calidad y cuesta bastante mas.
#   gemini-3.1-flash-image   (recomendado para empezar)
#   gemini-3.1-flash-lite-image
#   gemini-3-pro-image       (mejor calidad, mas caro)
#   gemini-2.5-flash-image   (el "Nano Banana" original)
GEMINI_MODEL=gemini-3.1-flash-image

# Corte de la llamada al modelo, en segundos. Debe ser MENOR que el corte del
# sondeo del navegador (120 s, en frontend/src/pages/TryOnPage.tsx).
GEMINI_TIMEOUT_SECONDS=100
