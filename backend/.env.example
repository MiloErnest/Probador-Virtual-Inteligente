# Copia este archivo a `.env` y ajusta los valores.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Bash:                cp .env.example .env
#
# `.env` está en .gitignore y NUNCA debe subirse al repositorio.

# --- Aplicación ---
PROJECT_NAME=Probador Virtual
ENVIRONMENT=local
DEBUG=true

# --- Seguridad ---
# Genera uno propio con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=clave-insegura-solo-para-desarrollo

# Duración del token de acceso (minutos). 720 = 12 horas.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Base de datos ---
# Formato: postgresql+psycopg://USUARIO:CONTRASENA@HOST:PUERTO/BASE
# Debe ser "+psycopg" (psycopg 3), no "+psycopg2".
DATABASE_URL=postgresql+psycopg://vfit:vfit_dev_password@localhost:5432/vfit

# --- CORS ---
# Orígenes del frontend autorizados, separados por comas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Almacenamiento de imágenes ---
# Disco local. La costura `Storage` permite cambiar a S3/R2 sin tocar el resto
# del código (ver app/services/storage.py).
PUBLIC_BASE_URL=http://localhost:8000
MAX_UPLOAD_MB=8

# --- Motor generativo para bocetos ---
#
# Un BOCETO no tiene sombras que reutilizar, asi que la unica forma de vestirlo
# es generar la imagen. Una FOTOGRAFIA no lo necesita: el motor determinista
# reutiliza su luz, sale gratis y da siempre el mismo resultado.
#
# "none"   = desactivado. Los bocetos no se pueden vestir y se dice por que.
#            Es el valor por defecto A PROPOSITO: que clonar el repositorio
#            empiece a gastar dinero de alguien seria una trampa.
# "openai" = API de OpenAI. SE COBRA POR IMAGEN.
#
# Un valor desconocido hace fallar el procesado; nunca cae al motor
# determinista en silencio.
AI_PROVIDER=none

# Se obtiene en https://platform.openai.com/api-keys
# NUNCA la escribas en el codigo ni la subas al repositorio.
#
# CUIDADO: una clave valida SIN SALDO falla igual, con un 429 cuyo mensaje no
# dice que falte dinero. Hay que anadir fondos en Settings -> Billing.
OPENAI_API_KEY=

# Modelo de imagen. Los "mini" son bastante mas baratos; los grandes dan mejor
# resultado en bocetos complicados. Verifica los precios vigentes antes de
# cambiarlo: este catalogo se mueve deprisa.
OPENAI_IMAGE_MODEL=gpt-image-1-mini

# "high" respeta el detalle de la imagen de entrada. Es la diferencia entre
# "tu diseno con otra tela" y "un diseno parecido al tuyo".
OPENAI_INPUT_FIDELITY=high

# Corte de la llamada, en segundos. Debe ser MENOR que el corte del sondeo del
# navegador; si no, el navegador se rinde antes de que la prueba termine.
OPENAI_TIMEOUT_SECONDS=100

# Techo de gasto DENTRO de la aplicacion, por usuario y 24 horas.
AI_TRIALS_PER_USER_PER_DAY=20
